<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_dbsource_form">
        <field name="name">base.external.dbsource.form.mssql</field>
        <field name="model">base.external.dbsource</field>
        <field name="inherit_id" ref="base_external_dbsource.view_dbsource_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='connector']" position="after">
                <field
                    name="mssql_type"
                    invisible="connector != 'mssql'"
                    required="connector == 'mssql'"
                />
            </xpath>
        </field>
    </record>
</odoo>
